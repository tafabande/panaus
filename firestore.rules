rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Owner or Partner can read/write. Any authenticated user can read if profile is discoverable.
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.partnerId == request.auth.uid || resource.data.discoverable == true);
      allow write: if request.auth != null && (request.auth.uid == userId || resource.data.partnerId == request.auth.uid);
    }
    
    // For all other feature collections (notes, calendar, etc.) assuming they store userId or partnerId
    match /{document=**} {
      allow read, write: if request.auth != null && (
          resource == null || 
          resource.data.userId == request.auth.uid || 
          resource.data.partnerId == request.auth.uid ||
          // legacy or generic items open to authed users for safety against accidental breakage
          !("userId" in resource.data)
      );
    }
  }
}
