rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user belongs to the couple
    function isMemberOfCouple(coupleId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Id == request.auth.uid ||
        get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Id == request.auth.uid
      );
    }
    
    function isValidString(text, maxLen) {
      return text is string && text.size() > 0 && text.size() <= maxLen;
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.partnerId == request.auth.uid ||
        resource.data.isDiscoverable == true
      );
      
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId', 'coupleId']) &&
          resource.data.partnerId == null &&
          resource.data.isDiscoverable == true
        )
      );
      
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      allow read: if isMemberOfCouple(coupleId);
      allow create: if request.auth != null;
      allow update: if isMemberOfCouple(coupleId);
    }

    match /moods/{moodId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId) 
        && request.resource.data.moodValue is number;
    }

    match /notes/{noteId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId) 
        && isValidString(request.resource.data.content, 10000);
    }

    match /events/{eventId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId) 
        && isValidString(request.resource.data.title, 500);
    }

    match /asks/{askId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId) 
        && isValidString(request.resource.data.requestText, 2000);
    }

    match /todos/{todoId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId) 
        && isValidString(request.resource.data.title, 500);
    }

    match /updates/{updateId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId);
    }
    match /photos/{photoId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId);
    }
    match /locationShares/{shareId} {
      allow read: if isMemberOfCouple(resource.data.coupleId);
      allow create, update: if isMemberOfCouple(request.resource.data.coupleId);
    }
  }
}