rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if the user belongs to the specified couple
    function isMemberOfCouple(coupleId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Id == request.auth.uid ||
        get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Id == request.auth.uid
      );
    }

    // Ensures the resource ownership hasn't changed (IDOR prevention)
    function isImmutable(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    function isValidString(text, maxLen) {
      return text is string && text.size() > 0 && text.size() <= maxLen;
    }

    // --- Rules ---

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        resource.data.partnerId == request.auth.uid ||
        resource.data.isDiscoverable == true
      );
      
      allow create: if isOwner(userId);
      
      allow update: if isOwner(userId) && isImmutable('userId');
      
      // Support for the pairing/discovery flow
      allow update: if isSignedIn() && 
        resource.data.isDiscoverable == true &&
        resource.data.partnerId == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId', 'coupleId']);
    }

    match /couples/{coupleId} {
      allow read: if isMemberOfCouple(coupleId);
      allow create: if isSignedIn() && (
        request.resource.data.user1Id == request.auth.uid ||
        request.resource.data.user2Id == request.auth.uid
      );
      allow update: if isMemberOfCouple(coupleId) && 
        isImmutable('user1Id') && isImmutable('user2Id');

      // --- Subcollections ---
      
      match /notes/{noteId} {
        allow read: if isMemberOfCouple(coupleId);
        allow create: if isMemberOfCouple(coupleId) && 
          request.resource.data.coupleId == coupleId &&
          request.resource.data.senderId == request.auth.uid &&
          isValidString(request.resource.data.content, 10000);
        allow update: if isMemberOfCouple(coupleId) && 
          resource.data.senderId == request.auth.uid &&
          isImmutable('senderId') && isImmutable('coupleId');
        allow delete: if isMemberOfCouple(coupleId) && 
          resource.data.senderId == request.auth.uid;
      }

      match /memories/{memoryId} {
        allow read: if isMemberOfCouple(coupleId);
        allow create, update: if isMemberOfCouple(coupleId) && 
          request.resource.data.coupleId == coupleId &&
          (resource == null || isImmutable('coupleId'));
        allow delete: if isMemberOfCouple(coupleId) && 
          resource.data.userId == request.auth.uid;
      }

      match /quizzes/{quizId} {
        allow read: if isMemberOfCouple(coupleId);
        allow create, update: if isMemberOfCouple(coupleId) && 
          (request.resource.data.userId == request.auth.uid);
      }
    }

    // Common pattern for shared features in TOP-LEVEL collections (filtered by coupleId)
    function canAccessSharedItem() {
      return isMemberOfCouple(resource.data.coupleId);
    }
    
    function canCreateSharedItem() {
      return isMemberOfCouple(request.resource.data.coupleId) &&
             (request.resource.data.userId == request.auth.uid || 
              request.resource.data.senderId == request.auth.uid ||
              request.resource.data.fromUserId == request.auth.uid ||
              request.resource.data.createdBy == request.auth.uid);
    }

    function canUpdateSharedItem() {
      return isMemberOfCouple(resource.data.coupleId) &&
             isMemberOfCouple(request.resource.data.coupleId) &&
             isImmutable('coupleId') &&
             (resource.data.userId == request.auth.uid || 
              resource.data.senderId == request.auth.uid ||
              resource.data.fromUserId == request.auth.uid ||
              resource.data.createdBy == request.auth.uid);
    }

    match /moods/{id} {
      allow read: if canAccessSharedItem();
      allow create: if canCreateSharedItem() && request.resource.data.moodValue is number;
      allow update: if canUpdateSharedItem() && (isImmutable('userId') || isImmutable('senderId'));
      allow delete: if canUpdateSharedItem();
    }

    match /events/{id} {
      allow read: if canAccessSharedItem();
      allow create: if canCreateSharedItem() && isValidString(request.resource.data.title, 500);
      allow update: if canUpdateSharedItem() && isImmutable('createdBy');
      allow delete: if canUpdateSharedItem();
    }

    match /asks/{id} {
      allow read: if canAccessSharedItem();
      allow create: if canCreateSharedItem() && isValidString(request.resource.data.requestText, 2000);
      
      // Recipient can update status/response
      allow update: if isMemberOfCouple(resource.data.coupleId) && 
        request.auth.uid == resource.data.toUserId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responseText', 'respondedAt']);
      
      // Creator can update content before response or delete
      allow update: if canUpdateSharedItem() && 
        resource.data.status == 'pending' &&
        isImmutable('fromUserId') && isImmutable('toUserId');
        
      allow delete: if canUpdateSharedItem() && resource.data.status == 'pending';
    }

    match /todos/{id} {
      allow read: if canAccessSharedItem();
      allow create: if canCreateSharedItem() && isValidString(request.resource.data.title, 500);
      allow update: if isMemberOfCouple(resource.data.coupleId) && isMemberOfCouple(request.resource.data.coupleId);
      allow delete: if canUpdateSharedItem();
    }

    match /interactions/{id} {
      allow read: if canAccessSharedItem();
      allow create: if canCreateSharedItem();
      // Recipient can mark as read
      allow update: if isMemberOfCouple(resource.data.coupleId) && 
        request.auth.uid != resource.data.senderId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if canUpdateSharedItem();
    }

    match /locationShares/{id} {
      allow read: if canAccessSharedItem();
      allow create: if canCreateSharedItem();
      allow update: if canUpdateSharedItem();
      allow delete: if canUpdateSharedItem();
    }
  }
}