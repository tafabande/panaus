rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /memories/{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /milestones/{folder}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
